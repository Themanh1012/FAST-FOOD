@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="login-page d-flex justify-content-center align-items-center">
    <div class="login-card shadow-lg">
        <div class="text-center mb-4">
            <img src="https://static.kfcvietnam.com.vn/images/web/kfc-logo.svg?v=5.0"
                 alt="KFC Logo" class="login-logo" />
            <h4 class="fw-bold text-uppercase mt-3">Quên mật khẩu</h4>
            <p class="text-muted">Nhập email của bạn để nhận liên kết đặt lại mật khẩu</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center">@ViewBag.Error</div>
        }
        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success text-center">@ViewBag.Success</div>
        }

        @using (Html.BeginForm("QuenMatKhau", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3 text-start">
                <label class="form-label fw-semibold">Email</label>
                <input type="email" name="email" class="form-control" placeholder="Nhập email của bạn" required />
            </div>

            <button type="submit" class="btn btn-danger w-100 mt-2">Gửi liên kết</button>

            <div class="text-center mt-3">
                <a href="@Url.Action("DangNhap", "Account")" class="text-danger fw-semibold">Quay lại đăng nhập</a>
            </div>
        }
    </div>
</section>
