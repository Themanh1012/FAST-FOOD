@model FAST_FOOD.Models.account
@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white text-center">
            <h4>Tạo tài khoản mới</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    @Html.LabelFor(m => m.TenDangNhap, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", placeholder = "Tên đăng nhập" })
                    @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.MatKhau, new { @class = "form-label fw-bold" })
                    @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Mật khẩu" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.HoTen, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                </div>
                <button type="submit" class="btn btn-success w-100">
                    <i class="bi bi-person-plus"></i> Đăng ký
                </button>
                <p class="text-danger mt-2 text-center">@ViewBag.Error</p>
            }
        </div>
    </div>
</div>
