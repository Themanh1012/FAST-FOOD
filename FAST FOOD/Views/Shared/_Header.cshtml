@using System.Web

@{
    ViewBag.Title = "_Header";
   
}

<nav class="navbar kfc-header fixed-top header">
    <div class="container-fluid">
        <div class="logo-box">
            <a href="@Url.Action("Index", "Home", new { area = "" })">
                <img src="https://static.kfcvietnam.com.vn/images/web/kfc-logo.svg?v=5.0" class="navbar-brand" width="60" alt="KFC Logo" />
            </a>

        </div>
        <div class="middle">

            <a class="navbar-brand"
               href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3009 })">
                Thực Đơn
            </a>

            <a class="navbar-brand"
               href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3009 })">
                Khuyến Mãi
            </a>
            <a class="navbar-brand" href="@Url.Action("DatTiec", "DatTiec", new { area = "" })">Dịch Vụ Tiệc</a>
            <a class="navbar-brand" href="@Url.Action("Index", "HeThongNhaHang", new { area = "" })">Hệ Thống Nhà Hàng</a>

        </div>


        <div class="right-header">
            <div class="cart-container">


                <a href="@Url.Action("Index", "Carts", new { area = "Customer" })" class="cart-icon" id="cartIcon">
                    <i class="fa-solid fa-basket-shopping"></i>
                    <span class="cart-badge" id="cartCount" data-lock="true">
                        @(Session["Cart"] != null ? ((List<FAST_FOOD.Models.CartItem>)Session["Cart"]).Sum(x => x.SoLuong) : 0) 
                    </span>
                </a>

            </div>




            <div class="icon-login">
                @if (Session["User"] != null)
                {
                    <a href="@Url.Action("Profile", "Account", new { area = "" })" class="login-link">
                        <i class="fa-solid fa-user-check"></i>
                    </a>

                }
                else
                {
            <a href="@Url.Action("Profile", "Account", new { area = "" })" class="login-link">
                <i class="fa-solid fa-user-large"></i>

            </a>

                }
            </div>



        </div>
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="offcanvasNavbarLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>

            <div class="offcanvas-body">

                <!-- ⭐ DANH MỤC MÓN ĂN -->
                <h6 class="fw-bold text-uppercase text-danger mb-3">Danh mục món ăn</h6>

                <ul class="list-unstyled mb-4 off-menu">
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3009 })" class="off-link">Khuyến mãi ></a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3010 })" class="off-link">Món mới ></a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3011 })" class="off-link">Combo 1 người ></a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3012 })" class="off-link">Combo nhóm ></a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3013 })" class="off-link">Gà rán - Gà quay ></a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3014 })" class="off-link">Burger - Cơm - Mì Ý ></a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3015 })" class="off-link">Thức ăn nhẹ ></a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3016 })" class="off-link">Thức uống & Tráng miệng ></a></li>
                    
                </ul>

                <hr />

                <!-- ⭐ VỀ KFC -->
                <h6 class="fw-bold text-uppercase text-danger mb-3">Về KFC</h6>
                <ul class="list-unstyled mb-4 off-menu">
                    <li><a href="@Url.Action("About", "Home")" class="off-link">Câu chuyện của chúng tôi ></a></li>                    
                    <li><a href="@Url.Action("TinTuc", "TinTuc", new { area = "" })" class="off-link">Tin tức KFC ></a></li>                   
                    <li><a href="@Url.Action("DatTiec", "DatTiec", new { area = "" })" class="off-link">Đặt tiệc></a></li>                    
                </ul>

                <hr />

                <!-- ⭐ LIÊN HỆ -->
                <h6 class="fw-bold text-uppercase text-danger mb-3">Liên hệ KFC</h6>
                <ul class="list-unstyled mb-4 off-menu">
                    
                    <li><a href="@Url.Action("Contact", "Home")" class="off-link">Liên hệ KFC ></a></li>
                </ul>

                <hr />

                <!-- ⭐ CHÍNH SÁCH -->
                <h6 class="fw-bold text-uppercase text-danger mb-3">Chính sách</h6>
                <ul class="list-unstyled off-menu">
                    <li><a href="@Url.Action("HoatDong", "ChinhSach")" class="off-link">Chính sách hoạt động ></a></li>
                    <li><a href="@Url.Action("QuyDinh", "ChinhSach")" class="off-link">Chính sách và quy định ></a></li>
                    <li><a href="@Url.Action("BaoMat", "ChinhSach")" class="off-link">Chính sách bảo mật thông tin ></a></li>
                </ul>

                <!-- ⭐ ICON ZALO + MESSENGER -->
                <!-- ⭐ FOOTER MINI TRONG OFFCANVAS -->
                <div class="offcanvas-footer mt-4 text-center">
                    <div class="social-icons mb-3 d-flex justify-content-center gap-4">
                        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#"><i class="fa-brands fa-youtube"></i></a>
                        <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    </div>

                    <p class="copy-text">Copyright © 2025 KFC Vietnam</p>
                </div>


            </div>

        </div>
    </div>
</nav>

