<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title -KFC</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link rel="stylesheet" href="~/Content/Site.css" />
    <link rel="stylesheet" href="~/Content/Style.css" />


    <link rel="stylesheet" href="~/Content/product.css" />

    <link rel="stylesheet" href="~/Content/Header01.css" />
    <link rel="stylesheet" href="~/Content/account.css" />
    <!-- Font Awesome Free -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!--Thư viện Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


</head>

<body>
    @Html.Partial("_Header")
    @Html.Partial("_Header2")
    <div class="container-fluid">
        @RenderBody()
    </div>

    @Html.Partial("_Footer")

    <script src="~/Scripts/popper.js"></script>
    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }

    @Scripts.Render("~/bundles/jquery")
    <script src="~/Scripts/Shop.js"></script>

    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>


    <script>
        AOS.init({
            duration: 650,
            easing: "ease-out-quart",
            once: true
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const recList = document.getElementById("recList");
            if (!recList) return;

            const itemWidth = 300;

            // Nhân đôi danh sách để tạo hiệu ứng loop mượt
            recList.innerHTML += recList.innerHTML;

            // MAX = 1 nửa chiều dài vì đã nhân đôi
            const maxScroll = recList.scrollWidth / 2;

            // ----- NÚT QUA PHẢI -----
            window.slideRight = function () {
                recList.scrollBy({ left: itemWidth, behavior: "smooth" });

                // Nếu qua quá nửa thì quay lại đầu
                setTimeout(() => {
                    if (recList.scrollLeft >= maxScroll) {
                        recList.scrollLeft = 0;
                    }
                }, 300);
            };

            // ----- NÚT QUA TRÁI -----
            window.slideLeft = function () {
                recList.scrollBy({ left: -itemWidth, behavior: "smooth" });

                // Nếu lùi quá 0 thì nhảy về cuối
                setTimeout(() => {
                    if (recList.scrollLeft <= 0) {
                        recList.scrollLeft = maxScroll - itemWidth;
                    }
                }, 300);
            };
        });
    </script>


</body>

</html>
