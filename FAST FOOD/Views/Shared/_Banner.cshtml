
@{
    ViewBag.Title = "_Banner";
}

<!--SLIDE-->
<div class="banner-wrapper">
    <div id="carouselExample" class="carousel slide slide1">

        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="https://static.kfcvietnam.com.vn/images/content/home/carousel/lg/6COB.webp?v=LKn6A3" class="d-block w-100" alt="01">
            </div>
            <div class="carousel-item">
                <img src="https://static.kfcvietnam.com.vn/images/content/home/carousel/lg/TNAG-P3.webp?v=w3or1g" class="d-block w-100" alt="02">
            </div>
            <div class="carousel-item">
                <img src="https://static.kfcvietnam.com.vn/images/content/home/carousel/lg/NewPasta.webp?v=w3or1g" class="d-block w-100" alt="03">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>