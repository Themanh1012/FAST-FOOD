
@{
    ViewBag.Title = "_Footer";
}

<link href="~/Content/Header01.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

<footer class="kfc-footer">
    <div class="footer-top container">
        <div class="footer-columns">

            <div class="footer-col">
                <h4>Danh Mục Món Ăn</h4>
                <ul>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3009 })">Ưu Đãi</a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3010 })">Món Mới</a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3011 })">Combo 1 Người</a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3012 })">Combo Nhóm</a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3013 })">Gà Rán - Gà Quay</a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3014 })">Burger - Cơm - Mì Ý</a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3015 })">Thức Ăn Nhẹ</a></li>
                    <li><a href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = 3016 })">Thức Uống & Tráng Miệng</a></li>
                    
                </ul>
            </div>

            <div class="footer-col">
                <h4>Về KFC</h4>
                <ul>
                    <li><a href="@Url.Action("About", "Home")">Câu Chuyện Của Chúng Tôi</a></li>                    
                    <li><a href="@Url.Action("TinTuc", "TinTuc", new { area = "" })">Tin Tức KFC</a></li>                   
                    <li><a href="@Url.Action("DatTiec", "DatTiec", new { area = "" })">Đặt Tiệc</a></li>                    
                </ul>
            </div>

            <div class="footer-col">
                <h4>Liên hệ KFC</h4>
                <ul>                   
                    <li><a href="@Url.Action("Index", "HeThongNhaHang")">Hệ Thống Nhà Hàng</a></li>
                    <li><a href="@Url.Action("Contact", "Home")">Liên hệ KFC</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Chính sách</h4>
                <ul>
                    <li><a href="@Url.Action("HoatDong", "ChinhSach")">Chính sách hoạt động</a></li>
                    <li><a href="@Url.Action("QuyDinh", "ChinhSach")">Chính sách và quy định</a></li>
                    <li><a href="@Url.Action("BaoMat", "ChinhSach")">Chính sách bảo mật thông tin</a></li>
                </ul>
            </div>

            <div class="footer-col download-app-col">

                @* 1. Tiêu đề: Chữ trắng, in đậm *@
                <h4 class="text-white fw-bold fs-5 mb-3">Download App</h4>

                @* 2. Container Nút: Dùng d-flex để căn ngang, gap-3 để tạo khoảng cách *@
                <div class="app-buttons-container d-flex flex-row gap-3">

                    @* Nút App Store *@
                    <a href="https://apps.apple.com/vn/app/kfc-vietnam/id562164615" class="text-decoration-none text-white d-flex align-items-center" style="font-size: 15px; transition: color 0.3s;">
                        @* Icon Apple: Màu trắng, kích thước lớn hơn *@
                        <i class="bi bi-apple" style="font-size: 1.5rem; margin-right: 5px; color:#ffffff;"></i>
                        App Store
                    </a>

                    @* Nút Google Play *@
                    <a href="https://play.google.com/store/apps/details?id=kfc.vietnam&hl=en" class="text-decoration-none text-white d-flex align-items-center" style="font-size: 15px; transition: color 0.3s;">
                        @* Icon Google Play: Màu đỏ KFC (Inline Style) *@
                        <i class="bi bi-google-play" style="font-size: 1.5rem; margin-right: 5px; color: #e2002d;"></i>
                        Google Play
                    </a>
                </div>
            </div>

        </div>

        <div class="footer-social">
            <a href="https://www.facebook.com/KFCVietnam/"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="https://www.instagram.com/kfc_vietnam/"><i class="fa-brands fa-instagram"></i></a>
            <a href="https://www.youtube.com/user/KFCVietnam2011"><i class="fa-brands fa-youtube"></i></a>
            <a href="https://x.com/kfc_vietnam"><i class="fa-brands fa-twitter"></i></a>
        </div>
