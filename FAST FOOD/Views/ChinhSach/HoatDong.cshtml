@{ ViewBag.Title = "Chính Sách Hoạt Động";

}
<link href="~/Content/ChinhSach.css" rel="stylesheet" />


@* Dán phần CSS ở Bước 2 vào đây hoặc vào _Layout *@
<div class="policy-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10 policy-content">
                <h2 class="policy-title">CHÍNH SÁCH HOẠT ĐỘNG</h2>

                <div class="policy-header">1. Phạm vi phục vụ</div>
                <p class="policy-text">
                    Hệ thống KFC Việt Nam phục vụ giao hàng tận nơi tại các khu vực có cửa hàng KFC trong bán kính quy định. Chúng tôi cam kết giao hàng nhanh chóng để đảm bảo chất lượng món ăn tốt nhất.
                </p>

                <div class="policy-header">2. Thời gian hoạt động</div>
                <ul class="policy-list">
                    <li>Thời gian nhận đơn hàng: Từ <strong>10:00 đến 21:00</strong> tất cả các ngày trong tuần.</li>
                    <li>Thời gian giao hàng: Trong vòng 30 - 45 phút sau khi xác nhận đơn hàng (tùy thuộc vào điều kiện thời tiết và giao thông).</li>
                </ul>

                <div class="policy-header">3. Quy trình xử lý đơn hàng</div>
                <p class="policy-text">
                    Sau khi quý khách đặt hàng trên website, nhân viên tổng đài sẽ liên hệ xác nhận trong vòng 5-10 phút. Đơn hàng chỉ được coi là thành công khi có xác nhận từ nhân viên KFC.
                </p>
            </div>
        </div>
    </div>
</div>
