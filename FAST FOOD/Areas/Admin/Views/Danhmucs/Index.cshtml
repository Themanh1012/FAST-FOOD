@model IEnumerable<FAST_FOOD.Models.Danhmuc>

@{
    ViewBag.Title = "Danh Sách Danh Mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-center text-primary mt-3" >@ViewBag.Title</h2>

<p>
    @Html.ActionLink(" ➕ Thêm Danh  Mục Mới", "Create", null, new {@class ="btn btn-success mb-3"})
</p>
<table class="table table-bordered text-center align-middle shadow">
    <thead class="table-dark">
        <tr>
            <th>Tên Danh Mục</th>
            <th>Hình Ảnh</th>
            <th>Hành Động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TenDanhMuc</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                    {
                        <img src="@Url.Content(item.HinhAnh)"
                             alt="@item.TenDanhMuc"
                             width="100" height="80"
                             style="object-fit:cover; border-radius:8px;" />
                    }
                    else
                    {
                        <span class="text-muted">Chưa có ảnh</span>
                    }
                </td>
                <td class="d-flex justify-content-center gap-2">
                    @Html.ActionLink("✏️ Sửa", "Edit", new { area = "Admin", id = item.DanhMucId }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("👁️ Xem", "Details", "Danhmucs", new { area = "Admin", id = item.DanhMucId }, new { @class = "btn btn-info btn-sm text-white" })
                    @Html.ActionLink("🗑️ Xóa", "Delete", "Danhmucs", new { area = "Admin", id = item.DanhMucId }, new { @class = "btn btn-danger btn-sm" })
                </td>

            </tr>
        }
    </tbody>
</table>
