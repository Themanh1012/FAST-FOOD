@model IEnumerable<FAST_FOOD.Models.ChiTietDonHang>

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var donHang = ViewBag.DonHang as FAST_FOOD.Models.DonHang;
}

<div class="container mt-4">

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-info text-white">
            <h4><i class="fas fa-info-circle"></i> Chi tiết đơn hàng #@donHang.MaDonHang</h4>
        </div>

        <div class="card-body">

            <!-- THÔNG TIN ĐƠN HÀNG -->
            <h5 class="fw-bold mb-3">Thông tin khách hàng</h5>

            <p><strong>Tên khách:</strong> @donHang.TenKhachHang</p>
            <p><strong>Số điện thoại:</strong> @donHang.SoDienThoai</p>
            <p><strong>Địa chỉ:</strong> @donHang.DiaChi</p>
            <p><strong>Ngày đặt:</strong> @donHang.NgayDat.ToString("dd/MM/yyyy")</p>
            <p><strong>Trạng thái:</strong> @donHang.TrangThai</p>

            <hr />

            <!-- DANH SÁCH MÓN -->
            <h5 class="fw-bold mb-3">Danh sách món đã đặt</h5>

            <table class="table table-bordered text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Món ăn</th>
                        <th>Ảnh</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MonAn.TenMon</td>

                            <td>
                                <img src="@Url.Content(item.MonAn.HinhAnh)" width="70" class="rounded" />
                            </td>

                            <td>@item.SoLuong</td>

                            <td>@String.Format("{0:N0} đ", item.MonAn.Gia)</td>

                            <td class="text-danger fw-bold">
                                @String.Format("{0:N0} đ", item.ThanhTien)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <h4 class="text-end text-danger fw-bold">
                Tổng tiền: @String.Format("{0:N0} đ", donHang.TongTien)
            </h4>

            <div class="mt-3">
                <a href="@Url.Action("Index", "DonHangs", new { area = "Admin" })"
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
            </div>

        </div>
    </div>

</div>
