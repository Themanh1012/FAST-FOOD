@model FAST_FOOD.Models.ChiTietDonHang

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.DonHangId)
    <div class="form-group">
        @Html.LabelFor(m => m.MonAnId)
        @Html.DropDownList("MonAnId", null, "Chọn món", new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.SoLuong)
        @Html.EditorFor(m => m.SoLuong, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <button type="submit" class="btn btn-success">Thêm món</button>
}


<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
