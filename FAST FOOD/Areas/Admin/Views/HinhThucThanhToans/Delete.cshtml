@model FAST_FOOD.Models.HinhThucThanhToan
@{
    ViewBag.Title = "Xóa Hình Thức Thanh Toán";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="alert alert-danger shadow-sm">
        <h4>Bạn có chắc muốn xóa hình thức thanh toán này không?</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Mã HTTT:</dt>
            <dd class="col-sm-9">@Model.MaHTTT</dd>

            <dt class="col-sm-3">Tên Hình Thức:</dt>
            <dd class="col-sm-9">@Model.TenHinhThuc</dd>
        </dl>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Xóa
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
        }
    </div>
</div>
