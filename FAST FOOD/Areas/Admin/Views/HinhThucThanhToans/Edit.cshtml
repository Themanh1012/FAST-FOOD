@model FAST_FOOD.Models.HinhThucThanhToan
@{
    ViewBag.Title = "Sửa Hình Thức Thanh Toán";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">@ViewBag.Title</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    @Html.LabelFor(model => model.TenHinhThuc, htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(model => model.TenHinhThuc, new { @class = "form-control", placeholder = "Nhập tên hình thức thanh toán..." })
                    @Html.ValidationMessageFor(model => model.TenHinhThuc, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Sửa
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            }
        </div>
    </div>
</div>
