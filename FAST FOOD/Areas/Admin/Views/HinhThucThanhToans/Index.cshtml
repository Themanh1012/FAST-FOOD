@model IEnumerable<FAST_FOOD.Models.HinhThucThanhToan>
@{
    ViewBag.Title = "Quản lý Hình Thức Thanh Toán";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary">Danh sách Hình Thức Thanh Toán</h2>
        <a href="@Url.Action("Create")" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm mới
        </a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-primary">
            <tr>
                <th>Mã HTTT</th>
                <th>Tên Hình Thức</th>
                <th class="text-center" style="width:180px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaHTTT</td>
                    <td>@item.TenHinhThuc</td>
                    <td class="text-center">
                        <a href="@Url.Action("Edit", new { id = item.MaHTTT })" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i> Sửa
                        </a>
                        <a href="@Url.Action("Details", new { id = item.MaHTTT })" class="btn btn-sm btn-info text-white">
                            <i class="bi bi-eye"></i> Xem
                        </a>
                        <a href="@Url.Action("Delete", new { id = item.MaHTTT })" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
