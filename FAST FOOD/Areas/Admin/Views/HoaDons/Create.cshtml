@model FAST_FOOD.Models.HoaDon

@{
    ViewBag.Title = "Tạo hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-center text-success mb-4">🧾 Tạo Hóa Đơn Mới</h2>

@using (Html.BeginForm("Create", "HoaDons", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="card shadow-sm p-4" style="border-radius:12px;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Mã đơn hàng -->
        <div class="mb-3">
            @Html.LabelFor(m => m.MaDonHang, "Đơn hàng", new { @class = "form-label fw-bold" })
            @Html.DropDownList("MaDonHang", null, "-- Chọn đơn hàng --", new { @class = "form-select", required = "required" })
        </div>

        <!-- Hình thức thanh toán -->
        <div class="mb-3">
            @Html.LabelFor(m => m.MaHTTT, "Hình thức thanh toán", new { @class = "form-label fw-bold" })
            @Html.DropDownList("MaHTTT", null, "-- Chọn hình thức --", new { @class = "form-select", required = "required" })
        </div>

        <!-- Tổng tiền -->
        <div class="mb-3">
            @Html.LabelFor(m => m.TongTien, "Tổng tiền (VNĐ)", new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.TongTien, new { @class = "form-control", type = "number", step = "1000", placeholder = "Nhập tổng tiền", required = "required" })
        </div>

        <!-- Ngày thanh toán -->
        <div class="mb-3">
            @Html.LabelFor(m => m.NgayThanhToan, "Ngày thanh toán", new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.NgayThanhToan, new { @class = "form-control", type = "datetime-local", value = Model.NgayThanhToan.ToString("yyyy-MM-ddTHH:mm") })
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-success px-4">✅ Lưu hóa đơn</button>
            @Html.ActionLink("↩️ Quay lại", "Index", null, new { @class = "btn btn-secondary px-4 ms-2" })
        </div>
    </div>
}
