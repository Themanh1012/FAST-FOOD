@model IEnumerable<FAST_FOOD.Models.HoaDon>
@{
    ViewBag.Title = "Danh sách hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-center text-primary mb-4">💰 Danh Sách Hóa Đơn</h2>

<p>
    @Html.ActionLink("➕ Tạo hóa đơn mới", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-striped table-bordered text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>Mã Đơn Hàng</th>
            <th>Hình Thức Thanh Toán</th>
            <th>Ngày Thanh Toán</th>
            <th>Tổng Tiền</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaDonHang</td>
                <td>@item.HinhThucThanhToan?.TenHTTT</td>
                <td>@item.NgayThanhToan.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@String.Format("{0:N0} đ", item.TongTien)</td>
                <td>
                    @Html.ActionLink("🔍 Chi tiết", "Details", new { id = item.MaHoaDon }, new { @class = "btn btn-info btn-sm text-white" })
                    @Html.ActionLink("✏️ Sửa", "Edit", new { id = item.MaHoaDon }, new { @class = "btn btn-warning btn-sm text-white" })
                    @Html.ActionLink("🗑️ Xóa", "Delete", new { id = item.MaHoaDon }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
