@model FAST_FOOD.Models.HoaDon
@{
    ViewBag.Title = "Xóa Hóa Đơn";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-5">
    <div class="alert alert-danger shadow-sm">
        <h4 class="fw-bold mb-3">Bạn có chắc muốn xóa hóa đơn này?</h4>
        <dl class="row">
            <dt class="col-sm-3">Mã Hóa Đơn:</dt>
            <dd class="col-sm-9">@Model.MaHoaDon</dd>

            <dt class="col-sm-3">Khách hàng:</dt>
            <dd class="col-sm-9">@Model.DonHang?.TenKhachHang</dd>

            <dt class="col-sm-3">Hình thức:</dt>
            <dd class="col-sm-9">@Model.HinhThucThanhToan?.TenHinhThuc</dd>

            <dt class="col-sm-3">Tổng tiền:</dt>
            <dd class="col-sm-9 text-danger fw-bold">@String.Format("{0:N0} ₫", Model.TongTien)</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger me-2">
                <i class="bi bi-trash"></i> Xóa
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Hủy
            </a>
        }
    </div>
</div>
