@model FAST_FOOD.Models.HoaDon

@{
    ViewBag.Title = "Chỉnh sửa hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-center text-warning mb-4">✏️ Chỉnh Sửa Hóa Đơn</h2>

@using (Html.BeginForm("Edit", "HoaDons", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MaHoaDon)

    <div class="card shadow-sm p-4" style="border-radius:12px;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Đơn hàng -->
        <div class="mb-3">
            @Html.LabelFor(m => m.MaDonHang, "Đơn hàng", new { @class = "form-label fw-bold" })
            @Html.DropDownList("MaDonHang", null, "-- Chọn đơn hàng --", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.MaDonHang, "", new { @class = "text-danger" })
        </div>

        <!-- Hình thức thanh toán -->
        <div class="mb-3">
            @Html.LabelFor(m => m.MaHTTT, "Hình thức thanh toán", new { @class = "form-label fw-bold" })
            @Html.DropDownList("MaHTTT", null, "-- Chọn hình thức --", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.MaHTTT, "", new { @class = "text-danger" })
        </div>

        <!-- Tổng tiền -->
        <div class="mb-3">
            @Html.LabelFor(m => m.TongTien, "Tổng tiền (VNĐ)", new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.TongTien, new { @class = "form-control", type = "number", step = "1000" })
            @Html.ValidationMessageFor(m => m.TongTien, "", new { @class = "text-danger" })
        </div>

        <!-- Ngày thanh toán -->
        <div class="mb-3">
            @Html.LabelFor(m => m.NgayThanhToan, "Ngày thanh toán", new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.NgayThanhToan, new { @class = "form-control", type = "datetime-local", value = Model.NgayThanhToan.ToString("yyyy-MM-ddTHH:mm") })
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-warning text-white px-4">💾 Lưu thay đổi</button>
            @Html.ActionLink("↩️ Quay lại", "Index", null, new { @class = "btn btn-secondary px-4 ms-2" })
        </div>
    </div>
}
