@model IEnumerable<FAST_FOOD.Models.MonAn>

@{
    ViewBag.Title = "Danh sách món ăn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-center text-primary mb-4">🍱 Danh Sách Món Ăn</h2>

<div class="d-flex justify-content-between align-items-center mb-3">

    <form method="get" action="">
        @Html.DropDownList(
     "categoryId",
     (SelectList)ViewBag.CategoryId,
     "Chọn danh mục",
     new { @class = "form-select", style = "width:250px;", onchange = "this.form.submit();" }
 )

    </form>


    @Html.ActionLink("➕ Thêm món mới", "Create", null, new { @class = "btn btn-success" })
</div>


<table class="table table-striped table-hover table-bordered align-middle text-center">
    <thead class="table-dark">
        <tr>
            <th>Tên Danh Mục</th>
            <th>Tên Món</th>
            <th>Giá</th>
            <th>Hình Ảnh</th>
            <th>Mô tả</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.DanhMuc?.TenDanhMuc ?? "Không có danh mục")</td>
                <td>@item.TenMon</td>
                <td>@String.Format("{0:N0} đ", item.Gia)</td>
                <td>
                    <img src="@Url.Content(string.IsNullOrEmpty(item.HinhAnh) ? "~/Images/noimage.png" : item.HinhAnh)"
                         alt="@item.TenMon" width="100" height="80" class="img-thumbnail" />
                </td>
                <td>@item.MoTa</td>

                <td class="text-center">
                    <div class="d-flex justify-content-center gap-2">

                        <a href="@Url.Action("Edit", new { id = item.MonAnId })"
                           class="btn btn-warning btn-sm">
                            ✏️
                        </a>

                        <a href="@Url.Action("Details", new { id = item.MonAnId })"
                           class="btn btn-info btn-sm text-white">
                            🔍
                        </a>

                        <a href="@Url.Action("Delete", new { id = item.MonAnId })"
                           class="btn btn-danger btn-sm">
                            🗑️
                        </a>

                    </div>
                </td>


            </tr>
        }
    </tbody>
</table>
