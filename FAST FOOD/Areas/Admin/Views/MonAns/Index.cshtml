@model IEnumerable<FAST_FOOD.Models.MonAn>

@{
    ViewBag.Title = "Danh sách món ăn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-center text-primary mb-4">🍱 Danh Sách Món Ăn</h2>

<p class="text-end">
    @Html.ActionLink("➕ Thêm món mới", "Create", null, new { @class = "btn btn-success mb-3" })
</p>

<table class="table table-striped table-hover table-bordered align-middle text-center">
    <thead class="table-dark">
        <tr>
            <th>Tên Danh Mục</th>
            <th>Tên Món</th>
            <th>Giá</th>
            <th>Hình Ảnh</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.DanhMuc?.TenDanhMuc ?? "Không có danh mục")</td>
                <td>@item.TenMon</td>
                <td>@String.Format("{0:N0} đ", item.Gia)</td>
                <td>
                    <img src="@Url.Content(string.IsNullOrEmpty(item.HinhAnh) ? "~/Images/noimage.png" : item.HinhAnh)"
                         alt="@item.TenMon" width="100" height="80" class="img-thumbnail" />
                </td>
                <td>
                    @Html.ActionLink("✏️ Sửa", "Edit", new { id = item.MonAnId }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("🔍 Chi tiết", "Details", new { id = item.MonAnId }, new { @class = "btn btn-info btn-sm text-white" })
                    @Html.ActionLink("🗑️ Xóa", "Delete", new { id = item.MonAnId }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
