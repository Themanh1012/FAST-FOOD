@model FAST_FOOD.Models.MonAn

@{
    ViewBag.Title = "Chỉnh sửa món ăn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-center text-warning mb-4">✏️ Chỉnh Sửa Món Ăn</h2>

@using (Html.BeginForm("Edit", "MonAns", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MonAnId)
    @Html.HiddenFor(m => m.HinhAnh)

<div class="card shadow-sm p-4" style="border-radius:12px;">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="mb-3">
        @Html.LabelFor(m => m.TenMon, "Tên món", new { @class = "form-label fw-bold" })
        @Html.TextBoxFor(m => m.TenMon, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Gia, "Giá (VNĐ)", new { @class = "form-label fw-bold" })
        @Html.TextBoxFor(m => m.Gia, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Hình hiện tại</label><br />
        <img src="@Url.Content(string.IsNullOrEmpty(Model.HinhAnh) ? "~/Images/noimage.png" : Model.HinhAnh)" width="120" class="img-thumbnail" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Chọn ảnh mới</label>
        <input type="file" name="HinhAnhFile" class="form-control" />
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.MoTa, "Mô tả món ăn", new { @class = "form-label fw-bold" })
        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3, placeholder = "Nhập mô tả món ăn..." })
    </div>
    <div class="mb-3">
        @Html.Label("Danh mục", htmlAttributes: new { @class = "form-label fw-bold" })
        @Html.DropDownList("DanhMucId", null, "-- Chọn danh mục --", new { @class = "form-select" })
    </div>

    <div class="text-center mt-4">
        <button type="submit" class="btn btn-warning text-white px-4">💾 Lưu thay đổi</button>
        @Html.ActionLink("↩️ Quay lại", "Index", null, new { @class = "btn btn-secondary px-4 ms-2" })
    </div>
</div>
}
