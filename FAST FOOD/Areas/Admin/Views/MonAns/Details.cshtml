@model FAST_FOOD.Models.MonAn

@{
    ViewBag.Title = "Chi tiết món ăn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-center text-info mb-4">🔍 Chi Tiết Món Ăn</h2>

<div class="card shadow-sm p-4" style="border-radius:12px;">
    <dl class="row">
        <dt class="col-sm-3">Danh mục</dt>
        <dd class="col-sm-9">@Model.DanhMuc?.TenDanhMuc</dd>

        <dt class="col-sm-3">Tên món</dt>
        <dd class="col-sm-9">@Model.TenMon</dd>

        <dt class="col-sm-3">Giá</dt>
        <dd class="col-sm-9">@String.Format("{0:N0} đ", Model.Gia)</dd>

        <dt class="col-sm-3">Hình ảnh</dt>
        <dd class="col-sm-9">
            <img src="@Url.Content(string.IsNullOrEmpty(Model.HinhAnh) ? "~/Images/noimage.png" : Model.HinhAnh)"
                 alt="@Model.TenMon" width="180" class="img-thumbnail" />
        </dd>
    </dl>

    <div class="text-center mt-3">
        @Html.ActionLink("✏️ Chỉnh sửa", "Edit", new { id = Model.MonAnId }, new { @class = "btn btn-warning text-white px-4" })
        @Html.ActionLink("↩️ Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary px-4 ms-2" })
    </div>
</div>
