@model FAST_FOOD.Models.MonAn

@{
    ViewBag.Title = "Thêm món ăn mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-center text-success mb-4">🍳 Thêm Món Ăn Mới</h2>

@using (Html.BeginForm("Create", "MonAns", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

<div class="card shadow-sm p-4" style="border-radius:12px;">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="mb-3">
        @Html.LabelFor(m => m.TenMon, "Tên món", new { @class = "form-label fw-bold" })
        @Html.TextBoxFor(m => m.TenMon, new { @class = "form-control", placeholder = "Nhập tên món ăn", required = "required" })
        @Html.ValidationMessageFor(m => m.TenMon, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Gia, "Giá (VNĐ)", new { @class = "form-label fw-bold" })
        @Html.TextBoxFor(m => m.Gia, new { @class = "form-control", type = "number", step = "1000", placeholder = "Nhập giá món ăn", required = "required" })
        @Html.ValidationMessageFor(m => m.Gia, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.Label("Danh mục", htmlAttributes: new { @class = "form-label fw-bold" })
        @Html.DropDownList("DanhMucId", null, "-- Chọn danh mục --", new { @class = "form-select", required = "required" })
        @Html.ValidationMessageFor(m => m.DanhMucId, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.Label("Hình ảnh", htmlAttributes: new { @class = "form-label fw-bold" })
        <input type="file" name="HinhAnhFile" class="form-control" accept="image/*" required />
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.MoTa, "Mô tả món ăn", new { @class = "form-label fw-bold" })
        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3, placeholder = "Nhập mô tả món ăn..." })
    </div>
    <div class="text-center mt-4">
        <button type="submit" class="btn btn-success px-4">✅ Lưu món ăn</button>
        @Html.ActionLink("↩️ Quay lại", "Index", null, new { @class = "btn btn-secondary px-4 ms-2" })
    </div>
</div>
}
