@model FAST_FOOD.Models.DonHang
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-4">🧾 Chi tiết đơn hàng #@Model.MaDonHang</h2>

    <div class="card shadow p-4 mb-4">
        <h4 class="fw-bold mb-3">👤 Thông tin khách hàng</h4>

        <p><strong>Tên khách:</strong> @Model.TenKhachHang</p>
        <p><strong>Địa chỉ:</strong> @Model.DiaChi</p>
        <p><strong>SĐT:</strong> @Model.SoDienThoai</p>
        <p><strong>Ngày đặt:</strong> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
        <p>
            <strong>Trạng thái:</strong>

            @if (Model.TrangThai == "Chờ xác nhận")
            {
                <span class="badge bg-warning text-dark">Chờ xác nhận</span>
            }
            else if (Model.TrangThai == "Đã xác nhận")
            {
                <span class="badge bg-success">Đã xác nhận</span>
            }
            else if (Model.TrangThai == "Đã Hủy")
            {
                <span class="badge bg-danger">Đã hủy</span>
            }
            else
            {
                <span class="badge bg-secondary">@Model.TrangThai</span>
            }
        </p>

        <p>
            <strong>Hình thức thanh toán:</strong>
            @(Model.HinhThucThanhToan != null
    ? Model.HinhThucThanhToan.TenHinhThuc
    : "Không có")

        </p>

        <h4 class="fw-bold mt-4">🍗 Danh sách món đã mua</h4>

        <table class="table table-bordered mt-3 shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Món ăn</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ct in Model.ChiTietDonHangs)
                {
                    <tr>
                        <td>
                            <img src="@Url.Content(ct.MonAn.HinhAnh)" width="70" class="rounded" />
                        </td>
                        <td>@ct.MonAn.TenMon</td>
                        <td>@ct.SoLuong</td>
                        <td class="text-danger fw-bold">@ct.ThanhTien.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="text-end fw-bold mt-3">
            Tổng tiền: <span class="text-danger">@Model.TongTien.ToString("N0") đ</span>
        </h4>

        <div class="mt-4">
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>

    </div>
</div>
