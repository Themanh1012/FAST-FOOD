@model FAST_FOOD.Models.DonHang
@{
    ViewBag.Title = "Cập Nhật Đơn Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center text-primary mb-4">Cập Nhật Trạng Thái Đơn Hàng</h2>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Mã đơn hàng:</label>
            <input class="form-control" value="@Model.MaDonHang" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Khách hàng:</label>
            <input class="form-control" value="@Model.TenKhachHang" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Trạng thái:</label>
            <select class="form-control" name="TrangThai">
                <option @("Đang xử lý" == Model.TrangThai ? "selected" : "")>Đang xử lý</option>
                <option @("Hoàn Tất" == Model.TrangThai ? "selected" : "")>Hoàn Tất</option>
                <option @("Đã Hủy" == Model.TrangThai ? "selected" : "")>Đã Hủy</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
    </form>
</div>
