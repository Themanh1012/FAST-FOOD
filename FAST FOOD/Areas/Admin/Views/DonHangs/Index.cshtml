@model IEnumerable<FAST_FOOD.Models.DonHang>

@{
    ViewBag.Title = "Danh Sách Đơn Hàng";
}

<div class="container mt-4">
    <h2 class="text-center text-primary mb-4">@ViewBag.Title</h2>

    <table class="table table-bordered table-hover text-center shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Mã Đơn Hàng</th>
                <th>Ngày Đặt </th>
                <th>Tổng Tiền</th>
                <th>Trạng Thái</th>
                <th>Hành Động</th>
            </tr>
        </thead>
    </table>




    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DonHangId)
            </td>
            <td>
               @item.NgayDat.ToString("dd/MM/yyyy")
            </td>
            <td>@string.Format("{0:N0} đ" , item.TongTien)</td>
            <td>
                @Html.DisplayFor(modelItem => item.TenKhachHang)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.DonHangId }) |
                @Html.ActionLink("Details", "Details", new { id = item.DonHangId }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.DonHangId })
            </td>
        </tr>
    }

    
</div>