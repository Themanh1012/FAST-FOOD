@model IEnumerable<FAST_FOOD.Models.DonHang>

@{
    ViewBag.Title = "Danh Sách Đơn Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center text-primary mb-4">@ViewBag.Title</h2>

    <table class="table table-bordered table-hover text-center shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Mã Đơn Hàng</th>
                <th>Tên Khách Hàng</th>

                <th>Tổng Tiền</th>
                <th>Ngày Đặt </th>
                <th>Trạng Thái</th>
                <th>Hành Động</th>
            </tr>
        </thead>
    <tbody>




    @foreach (var item in Model)
    {
       <tr>

           <td>@item.MaDonHang</td>
           <td>@item.TenKhachHang</td>

           <td>@String.Format("{0:N0} đ", item.TongTien)</td>
           <td>@item.NgayDat.ToString("dd/MM/yyyy")</td>

           <td>
               @if (item.TrangThai == "Đang xử lý")
               {
                   <span class="badge bg-warning text-dark">
                       <i class="fas fa-hourglass-half"></i>@item.TrangThai
                   </span>
               }
               else if (item.TrangThai == "Hoàn Tất")
               {
                   <span class="badge bg-success">
                       <i class="fas fa-check-circle"></i>@item.TrangThai
                   </span>
               }
               else if (item.TrangThai == "Đã Hủy")
               {
                   <span class="badge bg-danger">
                       <i class="fas fa-times-circle"></i>@item.TrangThai
                   </span>
               }
               else
               {
                   <span class="badge bg-secondary">@item.TrangThai</span>
               }
           </td>
           <td>
               <a href="@Url.Action("Edit", new { id = item.MaDonHang })" class="btn btn-warning btn-sm mx-1" title="Sửa">
                   <i class="fas fa-edit"></i>
               </a>

               <a href="@Url.Action("Index", "ChiTietDonHangs", new { area = "Admin", id = item.MaDonHang })"
                  class="btn btn-info btn-sm mx-1 text-white" title="Chi tiết">
                   <i class="fas fa-info-circle"></i> Chi tiết
               </a>

               <a href="@Url.Action("Delete", new { id = item.MaDonHang })" class="btn btn-danger btn-sm mx-1" title="Xóa">
                   <i class="fas fa-trash-alt"></i>
               </a>
           </td>




       </tr>
    }
        </tbody>
        </table>
    
</div>