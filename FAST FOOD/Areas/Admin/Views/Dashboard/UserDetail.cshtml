
@model FAST_FOOD.Models.UserOrderDetailViewModel

<h2 class="fw-bold mb-4">👤 Hồ sơ khách hàng</h2>

<div class="card shadow p-4 mb-4 user-card">
    <h3 class="fw-bold mb-1">@Model.HoTen</h3>
    <p class="text-muted mb-2">@Model.Email</p>
</div>

<h3 class="fw-bold mb-3">🛒 Lịch sử mua hàng</h3>

@if (!Model.DonHangs.Any())
{
    <p class="text-muted">Khách này chưa có đơn hàng nào.</p>
}
else
{
    <table class="table admin-table shadow-sm">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.DonHangs)
            {
                <tr>
                    <td>@d.MaDonHang</td>
                    <td>@d.NgayDat.ToString("dd/MM/yyyy")</td>
                    <td class="text-danger fw-bold">@d.TongTien.ToString("N0") đ</td>

                    <td>
                        <a href="@Url.Action("Details","DonHangs",new { id = d.MaDonHang })"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="fa-solid fa-receipt"></i> Xem đơn
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<style>
    .user-card {
        border-left: 5px solid #3498db;
        border-radius: 10px;
    }
</style>
