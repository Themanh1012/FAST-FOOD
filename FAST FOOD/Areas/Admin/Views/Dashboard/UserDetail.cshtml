@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@model FAST_FOOD.Models.UserOrderDetailViewModel

<div class="container mt-4">

    <h2 class="fw-bold mb-4">
        <i class="fa-solid fa-user text-primary"></i> Hồ sơ khách hàng
    </h2>

    <div class="card shadow-sm p-4 mb-4 user-card">
        <h3 class="fw-bold mb-1 text-dark">@Model.HoTen</h3>
        <p class="text-muted mb-2">@Model.Email</p>
    </div>

    <h3 class="fw-bold mb-3">
        <i class="fa-solid fa-cart-shopping text-success"></i> Lịch sử mua hàng
    </h3>

    @if (!Model.DonHangs.Any())
    {
        <div class="alert alert-info shadow-sm">
            Khách hàng này chưa có đơn hàng nào.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.DonHangs)
                {
                    <tr>
                        <td class="fw-bold">@d.MaDonHang</td>
                        <td>@d.NgayDat.ToString("dd/MM/yyyy")</td>
                        <td class="text-danger fw-bold">@d.TongTien.ToString("N0") đ</td>

                        <td>
                            <a href="@Url.Action("Details","DonHangs", new { area="Admin", id = d.MaDonHang })"
                               class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-receipt"></i> Xem đơn
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    .user-card {
        border-left: 5px solid #3498db;
        border-radius: 10px;
        background: white;
    }

    .table td, .table th {
        vertical-align: middle !important;
    }
</style>
