<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FAST FOOD</title>

    <!-- BOOTSTRAP 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Areas/Customer/Content/product.v2.css" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg bg-white shadow-sm fixed-top">
        <div class="container-fluid px-4">

            <a class="navbar-brand fw-bold" href="@Url.Action("Index","MonAns")">🍗 FAST FOOD</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item">@Html.ActionLink("🏠 Trang chủ", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("🍔 Món ăn", "Index", "MonAns", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("🛒 Giỏ hàng", "Index", "Carts", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("🧾 Lịch sử mua hàng", "Index", "LichSus", null, new { @class = "nav-link" })</li>
                </ul>
            </div>

        </div>
    </nav>

    <div style="margin-top:120px;">
        @RenderBody()

        <footer class="text-center text-muted mt-5 mb-3">
            <p>&copy; @DateTime.Now.Year - FAST FOOD Website</p>
        </footer>
    </div>

    <!-- BOOTSTRAP 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)


</body>
</html>
