@model FAST_FOOD.Models.Danhmuc
@{
    ViewBag.Title = "Danh mục - " + Model.TenDanhMuc;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center text-danger fw-bold mb-4">
        🍔 @Model.TenDanhMuc
    </h2>

    <div class="row">
        @if (Model.MonAns != null && Model.MonAns.Any())
        {
            foreach (var mon in Model.MonAns)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <img src="@Url.Content(mon.HinhAnh ?? "~/Images/noimage.png")"
                             class="card-img-top"
                             alt="@mon.TenMon"
                             style="height:220px; object-fit:cover;" />
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold text-dark">@mon.TenMon</h5>
                            <p class="text-muted">@mon.Gia.ToString("N0") đ</p>
                            <a href="@Url.Action("Details", "MonAns", new { id = mon.MonAnId })"
                               class="btn btn-outline-danger w-100">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted">
                Chưa có món nào trong danh mục này.
            </div>
        }
    </div>
</div>
