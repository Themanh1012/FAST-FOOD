@model FAST_FOOD.Models.DanhMucViewModel
@{
    ViewBag.Title = Model.DanhMuc.TenDanhMuc;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Areas/Customer/Content/product.css" />

<section class="category-menu menu01">
    <div class="menu-horizontal">
        @foreach (var dm in Model.Danhmucs)
        {
            <a class="menu-tab @(dm.DanhMucId == Model.DanhMuc.DanhMucId ? "active" : "")"
               href="@Url.Action("Category", "Danhmucs", new { area = "Customer", id = dm.DanhMucId })">
                @dm.TenDanhMuc
            </a>
        }
    </div>
</section>

<h2 class="category-title">@Model.DanhMuc.TenDanhMuc</h2>

<div class="product-grid">
    @foreach (var m in Model.MonAns)
    {
        <div class="product-card">
            <img src="@Url.Content(m.HinhAnh)" />
            <h3>@m.TenMon</h3>
            <p class="text-danger fw-bold">@m.Gia.ToString("N0") đ</p>
            <a class="btn btn-danger">Thêm</a>
        </div>
    }
</div>
