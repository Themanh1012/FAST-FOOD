@model FAST_FOOD.Models.DanhMucViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="category-container">

    <!-- DANH MỤC NGANG -->
    <div class="category-tabs">
        @foreach (var cat in Model.Danhmucs)
        {
            <a class="@(cat.DanhMucId == Model.DanhMuc.DanhMucId ? "active" : "")"
               href="@Url.Action("Category", "Danhmucs", new { area="Customer", id = cat.DanhMucId })">
                @cat.TenDanhMuc
            </a>
        }
    </div>

    <!-- TIÊU ĐỀ -->
    <h2 class="category-title">@Model.DanhMuc.TenDanhMuc</h2>

    <div class="row g-4 ">

        @foreach (var m in Model.MonAns)
        {
          <div class="col-6 col-md-3"
               data-aos="fade-up"
               data-aos-delay="@((m.MonAnId % 6) * 80)">
              <div class="kfc-card">

                  <a href="@Url.Action("Details", "MonAns", new { area = "Customer", id = m.MonAnId })">
                      <img src="@Url.Content(m.HinhAnh)" alt="@m.TenMon" class="kfc-img">
                  </a>

                  <div class="kfc-body">
                      <div class="kfc-title-row">
                          <div class="kfc-title">@m.TenMon</div>
                          <div class="kfc-price">@m.Gia.ToString("N0") đ</div>
                      </div>

                      <div class="kfc-desc">@m.MoTa</div>



                      <form action="@Url.Action("AddToCart", "Carts", new { area = "Customer" })" method="post" class="mt-2">
                          <input type="hidden" name="id" value="@m.MonAnId" />
                          <button type="button" class="kfc-btn" onclick="addToCart(@m.MonAnId)">Thêm</button>

                      </form>

                  </div>

              </div>
          </div>
        }

    </div>

</div>
<style>
    /* ĐẨY NỘI DUNG XUỐNG KHỎI HEADER */
    .category-container {
        margin-top: 140px;
        max-width: 1350px;
        margin-left: auto;
        margin-right: auto;
        padding: 0 25px;
        margin-bottom: 120px; /* hoặc 150px tuỳ ý */
    }
   
    /* TABS DANH MỤC */
    .category-tabs {
        display: flex;
        justify-content: center;
        gap: 35px;
        padding: 15px 0;
        border-bottom: 2px solid #eee;
        font-weight: 600;
        text-transform: uppercase;
    }

        .category-tabs a {
            text-decoration: none;
            color: #444;
            font-size: 16px;
            padding-bottom: 8px;
        }

            .category-tabs a.active {
                color: #d3232a;
                border-bottom: 3px solid #d3232a;
            }

    /* TIÊU ĐỀ */
    .category-title {
        font-size: 28px;
        font-weight: 800;
        color: #d3232a;
        margin: 25px 0;
        text-align: left;
    }

    /* CARD */
    .kfc-card {
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(0,0,0,0.12);
        transition: 0.25s;
    }

        .kfc-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.18);
        }

    /* ẢNH – NHỎ LẠI NHƯ KFC */
    .kfc-img {
        width: 80%; /* thu nhỏ ảnh */
        height: 170px;
        object-fit: contain; /* không cắt */
        display: block;
        margin: 15px auto 5px;
    }

    /* BODY */
    .kfc-body {
        padding: 12px 16px 20px;
    }

    /* TÊN – GIÁ */
    .kfc-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

    .kfc-title {
        font-size: 16px;
        font-weight: 700;
        color: #222;
    }

    .kfc-price {
        font-size: 15px;
        font-weight: 700;
        color: #d3232a;
    }

    /* MÔ TẢ */
    .kfc-desc {
        font-size: 13px;
        color: #555;
        line-height: 1.4;
        height: 38px;
        overflow: hidden;
        margin-bottom: 15px;
    }

    /* NÚT THÊM – NHỎ – MÀU NHẠT */
    .kfc-btn {
        width: 75%;
        margin: 0 auto;
        display: block;
        padding: 10px 0;
        border-radius: 40px;
        border: none;
        background: #f1f1f1;
        font-weight: 600;
        transition: 0.25s;
        text-decoration: none; /* ❗ bỏ dấu gạch dưới */
        color: #000;
    }

        .kfc-btn:hover {
            background: #d3232a;
            color: #fff;
        }

</style>