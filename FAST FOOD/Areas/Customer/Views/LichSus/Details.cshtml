@model FAST_FOOD.Models.DonHang
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <img src="https://cdn-icons-png.flaticon.com/512/845/845646.png"
         width="110" class="mb-3" />
</div>

<div class="container mt-5">

    <!-- TIÊU ĐỀ -->
    <h2 class="text-center fw-bold" style="color:#E4002B;">
        🧾 Chi tiết đơn hàng #@Model.MaDonHang
    </h2>

    <!-- THÔNG TIN ĐƠN HÀNG -->
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body p-4">

            <div class="row mb-3">
                <div class="col-md-6">
                    <p class="mb-2"><b>👤 Tên khách hàng:</b> @Model.TenKhachHang</p>
                </div>
                <div class="col-md-6">
                    <p class="mb-2">
                        <b>📅 Ngày đặt:</b> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <p class="mb-2">
                        <b>💵 Tổng tiền:</b>
                        <span class="text-danger fw-bold">@String.Format("{0:N0} đ", Model.TongTien)</span>
                    </p>
                </div>
                <div class="col-md-6">
                    <p class="mb-2">
                        <b>📌 Trạng thái:</b>
                        <span class="badge bg-warning text-dark px-3 py-2">
                            @Model.TrangThai
                        </span>
                    </p>
                </div>
            </div>

            <p class="mb-2">
                <b>💳 Hình thức thanh toán:</b>
                <span class="fw-semibold">
                    @(Model.HinhThucThanhToan != null ? Model.HinhThucThanhToan.TenHinhThuc : "Chưa chọn")
                </span>
            </p>
        </div>
    </div>

    <!-- DANH SÁCH MÓN -->
    <h4 class="mt-4 fw-bold">🍗 Danh sách món ăn</h4>

    <table class="table table-bordered table-hover mt-3 text-center align-middle shadow-sm">
        <thead style="background:#FFF5F5;">
            <tr>
                <th class="fw-bold">Tên món</th>
                <th class="fw-bold">Số lượng</th>
                <th class="fw-bold">Đơn giá</th>
                <th class="fw-bold">Thành tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.ChiTietDonHangs)
            {
                <tr>
                    <td class="fw-semibold">
                        @(item.MonAn != null ? item.MonAn.TenMon : "Món không tồn tại")
                    </td>
                    <td>@item.SoLuong</td>
                    <td>@String.Format("{0:N0} đ", item.MonAn?.Gia)</td>
                    <td class="text-danger fw-bold">@String.Format("{0:N0} đ", item.ThanhTien)</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- NÚT QUAY LẠI -->
    <div class="text-end mt-3">
        <a href="@Url.Action("Index", "LichSus")"
           class="btn btn-dark px-4 py-2">
            ⬅ Quay lại
        </a>
    </div>
</div>


