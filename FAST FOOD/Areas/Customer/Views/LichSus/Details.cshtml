@model FAST_FOOD.Models.DonHang
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center text-info mb-4">Chi tiết đơn hàng #@Model.MaDonHang</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <p><b>Tên khách hàng:</b> @Model.TenKhachHang</p>
            <p><b>Ngày đặt:</b> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
            <p><b>Tổng tiền:</b> @String.Format("{0:N0} đ", Model.TongTien)</p>
            <p><b>Trạng thái:</b> @Model.TrangThai</p>
            <p><b>Hình thức thanh toán:</b> @(Model.HinhThucThanhToan != null ? Model.HinhThucThanhToan.TenHinhThuc : "Chưa chọn")</p>
        </div>
    </div>

    <h4>Danh sách món ăn</h4>
    <table class="table table-striped table-bordered text-center align-middle">
        <thead class="table-light">
            <tr>
                <th>Tên món</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ChiTietDonHangs)
            {
                <tr>
                    <td>@(item.MonAn != null ? item.MonAn.TenMon : "Món không tồn tại")</td>
                    <td>@item.SoLuong</td>
                    <td>@String.Format("{0:N0} đ", item.MonAn?.Gia)</td>
                    <td>@String.Format("{0:N0} đ", item.ThanhTien)</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end">
        <a href="@Url.Action("Index", "LichSus")" class="btn btn-secondary">⬅ Quay lại</a>
    </div>
</div>


