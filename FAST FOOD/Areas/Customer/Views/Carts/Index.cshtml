@using System.Linq
@model List<FAST_FOOD.Models.CartItem>
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal total = ViewBag.Total ?? 0;
}
<style>
    .cart-page {
        margin-top: 240px !important; /* chuẩn rồi */
    }
    /* đẩy toàn bộ xuống khỏi header */

</style>
<div class="mb-4">
    <img src="https://cdn-icons-png.flaticon.com/512/845/845646.png"
         width="90" class="mb-3" />
</div>

<div class="container mt-5 mb-5">

    <h2 class="text-center fw-bold mb-4" style="color:#d60000;">
        🛒 Giỏ hàng của bạn
    </h2>

    <div class="card border-0 shadow-lg p-4" style="border-radius:20px;">

        <table class="table align-middle text-center">
            <thead style="background:#ffe5e5; font-size:17px;">
                <tr class="fw-bold text-danger">
                    <th>Ảnh</th>
                    <th>Tên món</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr style="height:120px;">
                        <td>
                            <img src="@Url.Content(item.HinhAnh)"
                                 style="width:95px;height:85px;object-fit:cover;border-radius:10px;">
                        </td>

                        <td class="fw-semibold fs-5">@item.TenMon</td>

                        <td class="text-secondary fw-bold">@item.Gia.ToString("N0") đ</td>

                        <td>
                            <form action="@Url.Action("UpdateQuantity", "Carts")" method="post" class="d-flex justify-content-center gap-2">
                                <input type="hidden" name="id" value="@item.MonAnId" />

                                <input type="number" name="quantity"
                                       class="form-control text-center"
                                       value="@item.SoLuong" min="1"
                                       style="width:70px;border-radius:10px;">

                                <button class="btn btn-outline-primary px-3"
                                        style="border-radius:10px;">
                                    Cập nhật
                                </button>
                            </form>
                        </td>

                        <td class="fw-bold text-danger fs-5">
                            @item.ThanhTien.ToString("N0") đ
                        </td>

                        <td>
                            <a href="@Url.Action("Remove", "Carts", new { id = item.MonAnId })"
                               class="btn btn-outline-danger px-3"
                               style="border-radius:10px;">
                                ❌ Xóa
                            </a>
                        </td>
                    </tr>
                }

            </tbody>
        </table>

        <hr />

        <div class="d-flex justify-content-between align-items-center mt-4">
            <h4 class="fw-bold m-0">Tổng cộng:</h4>
            <h4 class="fw-bold text-danger m-0">@total.ToString("N0") đ</h4>
        </div>

        <div class="text-center mt-3">
            <a href="@Url.Action("Checkout", "Carts")"
               class="btn fw-bold px-4 py-2"
               style="font-size:18px;border-radius:10px;background:#d60000;color:white;">
                🧾 Đặt hàng
            </a>
        </div>

    </div>

</div>
