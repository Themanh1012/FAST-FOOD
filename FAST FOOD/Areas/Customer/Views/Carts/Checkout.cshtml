@model IEnumerable<FAST_FOOD.Models.CartItem>
@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal total = ViewBag.Total ?? 0;
}

<div class="container mt-5">
    <div class="row g-4">

        <!-- CỘT TRÁI -->
        <div class="col-md-6">
            <div class="card shadow-sm p-4">
                <h3 class="text-success text-center mb-4">Thông tin đặt hàng</h3>

                @using (Html.BeginForm("Checkout", "Carts", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên khách hàng</label>
                        <input type="text" name="TenKhachHang" class="form-control form-control-lg" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Địa chỉ giao hàng</label>
                        <input type="text" name="DiaChi" class="form-control form-control-lg" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại</label>
                        <input type="tel" name="SoDienThoai" class="form-control form-control-lg" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú đơn hàng</label>
                        <textarea name="GhiChu" rows="2" class="form-control form-control-lg"></textarea>
                    </div>

                    <hr />

                    <!-- Phương thức thanh toán -->
                    <h5 class="fw-bold text-primary mb-3">Phương thức thanh toán</h5>

                    <div class="row row-cols-2 g-3">
                        @foreach (var p in (SelectList)ViewBag.MaHTTT)
                        {
                            string icon = "~/Content/pay/default.png";

                            if (p.Text.Contains("Tiền mặt")) { icon = "~/Content/pay/cash.png"; }
                            if (p.Text.Contains("Momo")) { icon = "~/Content/pay/momo.png"; }
                            if (p.Text.Contains("Visa")) { icon = "~/Content/pay/visa.png"; }
                            if (p.Text.Contains("VNPay")) { icon = "~/Content/pay/vnpay.png"; }
                            if (p.Text.Contains("Zalo")) { icon = "~/Content/pay/zalo.png"; }

                            <div class="col">
                                <label class="border rounded p-2 d-flex align-items-center gap-2">
                                    <input type="radio" name="MaHTTT" value="@p.Value" required />
                                    <img src="@Url.Content(icon)" style="width:30px;height:30px;object-fit:contain;" />
                                    <span>@p.Text</span>
                                </label>
                            </div>
                        }
                    </div>

                    <button type="submit" class="btn btn-danger btn-lg w-100 mt-4 fw-bold">
                        Xác nhận đặt hàng
                    </button>
                }
            </div>
        </div>


        <!-- CỘT PHẢI -->
        <div class="col-md-5">
            <div class="card shadow-lg p-4" style="border-radius:20px;">

                <h3 class="text-center fw-bold text-danger mb-4">Giỏ hàng của bạn</h3>

                @foreach (var item in Model)
                {
                    <div class="card mb-3 border-0 shadow-sm" style="border-radius:15px;">
                        <div class="card-body d-flex">

                            <img src="@Url.Content(item.HinhAnh)"
                                 style="width:120px;height:110px;object-fit:cover;border-radius:12px;"
                                 class="me-3" />

                            <div class="flex-grow-1">
                                <div class="fw-bold fs-5">@item.TenMon</div>
                                <div class="text-muted small mb-2">
                                    @item.Gia.ToString("N0") đ × @item.SoLuong
                                </div>

                                <div class="fw-bold text-danger fs-5 text-end">
                                    @item.ThanhTien.ToString("N0") đ
                                </div>
                            </div>

                        </div>
                    </div>
                }

                <hr class="my-4">

                <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-4">Tổng cộng:</span>
                    <span class="fw-bold text-danger fs-4">@ViewBag.Total.ToString("N0") đ</span>
                </div>

            </div>
        </div>

    </div>
</div>









