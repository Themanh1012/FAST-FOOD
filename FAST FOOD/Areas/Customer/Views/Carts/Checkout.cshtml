@model IEnumerable<FAST_FOOD.Models.CartItem>
@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal total = ViewBag.Total ?? 0;
}

<div class="container checkout-page mt-5">
    <div class="row">
        <!-- CỘT TRÁI: Thông tin khách hàng -->
        <div class="col-md-7">
            <h2 class="text-success mb-4 text-center">
                <i class="bi bi-person-lines-fill"></i> Thông tin đặt hàng
            </h2>

            @using (Html.BeginForm("Checkout", "Carts", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="card p-4 shadow-sm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên khách hàng</label>
                        <input type="text" name="TenKhachHang" class="form-control" placeholder="Nhập họ tên của bạn" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Địa chỉ giao hàng</label>
                        <input type="text" name="DiaChi" class="form-control" placeholder="Nhập địa chỉ nhận hàng" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại</label>
                        <input type="tel" name="SoDienThoai" class="form-control" placeholder="Nhập số điện thoại liên hệ" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú đơn hàng</label>
                        <textarea name="GhiChu" class="form-control" rows="2" placeholder="Ví dụ: Giao buổi trưa, thêm tương ớt..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình thức thanh toán</label>
                        @Html.DropDownList("MaHTTT", (SelectList)ViewBag.MaHTTT, "Chọn hình thức", new { @class = "form-select" })
                    </div>
                </div>
            }
        </div>

            <!-- CỘT PHẢI: Tóm tắt đơn hàng -->
            <div class="col-md-5">
                <h2 class="text-center text-danger mb-4"><i class="bi bi-cart4"></i> Giỏ hàng của bạn</h2>

                <div class="card shadow-sm p-4">
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in Model)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">

                                    <img src="@Url.Content(item.HinhAnh)" alt="@item.TenMon"
                                         width="80" class="rounded shadow-sm"
                                         style="object-fit: cover; margin-right: 15px;" />

                                    <div>
                                        <strong>@item.TenMon</strong><br />
                                        <small class="text-muted">@item.Gia.ToString("N0") đ x @item.SoLuong</small>
                                    </div>
                                </div>
                                <span class="fw-bold text-danger">@item.ThanhTien.ToString("N0") đ</span>
                            </li>
                        }
                    </ul>

                    <hr />
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Tổng cộng:</span>
                        <span class="fw-bold fs-5 text-danger">@total.ToString("N0") đ</span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 mt-4 fw-bold">
                        <i class="bi bi-check-circle"></i> Xác nhận đặt hàng
                    </button>
                </div>
                
            </div>
        </div>
    </div>
<style>
    .checkout-page {
        margin-top: 140px !important;
    }
</style>


